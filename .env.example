# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다 (.gitignore).
# 포트는 기본 포트와 겹치지 않게 정했다 (ADR-0008). 모두 127.0.0.1에만 열린다.

# --- 포트 ---
RQL_DB_PORT=15432
RQL_API_PORT=18080
RQL_WEB_PORT=15173

# --- PostgreSQL ---
RQL_DB_NAME=rql
RQL_DB_USER=rql
# 로컬 전용 임의 문자열로 바꾼다
RQL_DB_PASSWORD=change-me-local-only

# --- 임베딩 (호스트 네이티브 Ollama, ADR-0002/0003) ---
RQL_EMBEDDING_MODEL=qwen3-embedding:0.6b
# 호스트에서 API를 실행할 때 사용 (개발 모드)
OLLAMA_BASE_URL=http://localhost:11434
# API를 컨테이너로 실행할 때 사용 (데모 모드)
RQL_OLLAMA_URL_FROM_CONTAINER=http://host.docker.internal:11434

# --- 생성 LLM (Gemini 무료 티어, ADR-0004) ---
# 결제가 연결되지 않은 Google 프로젝트의 키만 사용한다. 결제를 연결하면 같은 키가 유료로 과금될 수 있다.
GEMINI_API_KEY=
# 키가 없으면 none(채팅 기능 없이 기동). 키를 넣었으면 google-genai
RQL_CHAT_PROVIDER=none
RQL_GENERATION_MODEL=gemini-3.5-flash-lite

# --- 관리자 (ADM-01) ---
# 관리자 계정이 하나도 없을 때만 이 값으로 초기 관리자 1명을 만든다. 이후에는 무시된다
ADMIN_INITIAL_USERNAME=admin
# 12자 이상. 비워 두면 관리자 계정을 만들지 않는다
ADMIN_INITIAL_PASSWORD=
# 관리자 세션 유휴 만료
RQL_ADMIN_SESSION_TIMEOUT=30m
# HTTPS로 배포할 때만 true (로컬 HTTP에서는 false)
RQL_COOKIE_SECURE=false
